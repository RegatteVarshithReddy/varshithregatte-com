---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Check your email — varshithregatte.com" description="Confirm your newsletter subscription." noindex>
  <h1 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100">Check your email</h1>
  <p class="mt-4 text-neutral-700 dark:text-neutral-300">
    If that address is valid, a confirmation link is on its way. Click it to finish subscribing. The link
    expires in 48 hours, and it can land in spam, so check there too.
  </p>
</BaseLayout>
