---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="You're subscribed — varshithregatte.com" description="Newsletter subscription confirmed." noindex>
  <h1 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100">You're subscribed</h1>
  <p class="mt-4 text-neutral-700 dark:text-neutral-300">
    Thanks. New posts will land in your inbox, and every email has an unsubscribe link.
  </p>
  <a href="/" class="mt-6 inline-block text-sm text-neutral-600 underline hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100">
    Back to the site
  </a>
</BaseLayout>
