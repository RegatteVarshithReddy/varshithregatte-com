---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTags } from "../../lib/posts";

const tags = await getTags();
---

<BaseLayout title="Tags — varshithregatte.com" description="Browse posts by topic.">
  <h1 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100">Tags</h1>
  <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Browse posts by topic.</p>
  {tags.length === 0 ? (
    <p class="mt-8 text-sm text-neutral-500 dark:text-neutral-400">No tags yet.</p>
  ) : (
    <ul class="mt-8 flex flex-wrap gap-3">
      {tags.map((tag) => (
        <li>
          <a
            href={`/tags/${tag.slug}/`}
            class="inline-flex items-center gap-2 rounded-full border border-neutral-200 px-3 py-1 font-mono text-sm text-neutral-700 hover:border-neutral-400 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-neutral-600"
          >
            #{tag.label}
            <span class="text-xs text-neutral-500 dark:text-neutral-400">{tag.posts.length}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
