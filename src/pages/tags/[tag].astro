---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getTags } from "../../lib/posts";

export async function getStaticPaths() {
  return (await getTags()).map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

const { tag } = Astro.props;
const count = tag.posts.length;
---

<BaseLayout
  title={`#${tag.label} — varshithregatte.com`}
  description={`${count} ${count === 1 ? "post" : "posts"} tagged ${tag.label}.`}
>
  <p class="text-sm"><a href="/tags/" class="text-neutral-500 hover:underline dark:text-neutral-400">All tags</a></p>
  <h1 class="mt-2 font-mono text-2xl font-semibold text-neutral-900 dark:text-neutral-100">#{tag.label}</h1>
  <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{count} {count === 1 ? "post" : "posts"}</p>
  <div class="mt-8">
    {tag.posts.map(({ key, post }) => <PostCard pillarKey={key} post={post} />)}
  </div>
</BaseLayout>
