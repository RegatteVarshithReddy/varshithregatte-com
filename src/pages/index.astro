---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getAllPosts } from "../lib/posts";

const posts = await getAllPosts();
---

<BaseLayout
  title="Varshith Regatte"
  description="Writing on business & life skills, book notes, homelab builds, and AI news."
>
  <p class="text-sm text-neutral-600 dark:text-neutral-400">
    Sysadmin, homelabber, and aspiring AI entrepreneur. I write about what I'm building, reading, and learning.
  </p>
  <div class="mt-8">
    {posts.map(({ key, post }) => <PostCard pillarKey={key} post={post} />)}
  </div>
</BaseLayout>
